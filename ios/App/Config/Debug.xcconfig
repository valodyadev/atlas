#include "Base.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = com.atlas.app.debug
PRODUCT_NAME = Atlas Dev

ATLAS_ENVIRONMENT = development
ATLAS_API_BASE_URL = http:/$()/localhost:8080/api/v1

SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG
SWIFT_OPTIMIZATION_LEVEL = -Onone
ONLY_ACTIVE_ARCH = YES

// Localhost is plain HTTP in development only; see Info.plist, where the ATS
// exception is scoped to localhost and nothing else.
