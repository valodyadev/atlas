{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "//": "No secrets live in this file. Connection strings and credentials come from environment variables or a secret manager - see docs/security/secrets.md.",
  "ConnectionStrings": {
    "Default": ""
  },
  "Auth": {
    "Enabled": true
  },
  "RateLimit": {
    "PermitLimit": 300,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "Identity": {
    "Auth": {
      "SigningKey": "",
      "Issuer": "atlas",
      "Audience": "atlas-api",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 30,
      "LockoutThreshold": 5,
      "LockoutBaseSeconds": 30,
      "LockoutMaxSeconds": 3600,
      "MinimumPasswordLength": 12
    }
  }
}
