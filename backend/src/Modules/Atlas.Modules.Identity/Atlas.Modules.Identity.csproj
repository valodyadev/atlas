<Project Sdk="Microsoft.NET.Sdk">

  <!-- Reference module. Copy this project's shape when adding a new module:
       Domain -> Application -> Infrastructure -> Endpoints, one Postgres
       schema, one DbContext, no project reference to any sibling module. -->

  <PropertyGroup>
    <RootNamespace>Atlas.Modules.Identity</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../Atlas.SharedKernel/Atlas.SharedKernel.csproj" />
    <ProjectReference Include="../../Atlas.ServiceDefaults/Atlas.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <!-- Design-time only: needed by `dotnet ef`, never shipped. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
  </ItemGroup>

</Project>
