<Project>

  <!-- ======================================================================
       Repo-wide MSBuild defaults. Every project in backend/ inherits these,
       so individual .csproj files stay almost empty and cannot drift.
       ====================================================================== -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Quality gates: warnings are errors in CI, analyzers always on. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Reproducible, debuggable builds. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <DebugType>portable</DebugType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Lock files make restore reproducible: CI restores in locked mode, so a
         transitive dependency cannot change under us between the commit that
         was reviewed and the build that ships. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- Supply-chain: fail the build if a restored package has a known CVE. -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>

    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Atlas</Product>
    <Company>Atlas</Company>
    <Authors>Atlas Engineering</Authors>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

</Project>
