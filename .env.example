# ---------------------------------------------------------------------------
# Local development environment template.
#
#   cp .env.example .env     # .env is git-ignored and never leaves your machine
#
# This file documents every variable the stack reads. It contains ONLY
# non-production placeholder values. Real secrets live in a secret manager
# (see docs/security/secrets.md) and are never written here.
# ---------------------------------------------------------------------------

# --- Shared ---------------------------------------------------------------
ENVIRONMENT=Development
LOG_LEVEL=Information

# --- Postgres (docker compose) -------------------------------------------
POSTGRES_USER=atlas
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=atlas
POSTGRES_PORT=5432

# --- .NET backend ---------------------------------------------------------
# ASP.NET Core reads nested config keys with "__" as the separator.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080
ConnectionStrings__Default=Host=localhost;Port=5432;Database=atlas;Username=atlas;Password=local-dev-only

# --- Authentication ----------------------------------------------------
# This system issues and validates its own tokens, so it needs a signing key.
# There is no default, and the API refuses to start without one.
#
# Generate your own - do NOT ship this placeholder:
#     openssl rand -base64 48
Auth__Enabled=true
Identity__Auth__SigningKey=replace-me-with-at-least-32-bytes-of-random-base64
Identity__Auth__Issuer=atlas
Identity__Auth__Audience=atlas-api
Identity__Auth__AccessTokenMinutes=15
Identity__Auth__RefreshTokenDays=30

# --- Observability (OpenTelemetry) ---------------------------------------
OTEL_SERVICE_NAME=atlas-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# --- Satellite services ---------------------------------------------------
NODE_WORKER_PORT=8081
PYTHON_WORKER_PORT=8082
